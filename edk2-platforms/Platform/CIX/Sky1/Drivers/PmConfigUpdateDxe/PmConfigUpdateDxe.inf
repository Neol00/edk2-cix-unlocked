[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = PmConfigUpdateDxe
  FILE_GUID                      = 8a3c2f7e-d614-4b8a-9e05-6f7d3c1a4b2e
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = PmConfigUpdateDxeEntryPoint

[Sources]
  PmConfigUpdateDxe.c
  PmConfigUpdateDxe.h

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  Platform/CIX/Sky1/Sky1.dec
  Silicon/CIX/Sky1/CixPkg.dec

[LibraryClasses]
  BaseLib
  BaseMemoryLib
  DebugLib
  MemoryAllocationLib
  UefiBootServicesTableLib
  UefiDriverEntryPoint
  UefiRuntimeServicesTableLib
  UefiLib

[Protocols]
  gCixFirmwareUpdateProtocolGuid        ## CONSUMES
  gEfiAcpiSdtProtocolGuid               ## CONSUMES

[Guids]
  gPlatformSetupVariableGuid
  gEfiEventReadyToBootGuid

[Depex]
  gCixFirmwareUpdateProtocolGuid AND gEfiAcpiSdtProtocolGuid
