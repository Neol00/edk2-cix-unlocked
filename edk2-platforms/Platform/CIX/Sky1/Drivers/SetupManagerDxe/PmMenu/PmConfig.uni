#langdef en-US  "English"
/*
* Power Management OPP Configuration settings.
*/

// Form title and help
#string STR_PM_FORM_TITLE              #language en-US "PM OPP Configuration"
#string STR_PM_FORM_TITLE_HELP         #language en-US "Press <Enter> to configure OPP-entry's frequency and voltage for all DVFS domains, TDP power caps."

// Domain subtitle headers
#string STR_PM_GPU_CORE_TITLE          #language en-US "--- GPU Core (Domain 0) ---"
