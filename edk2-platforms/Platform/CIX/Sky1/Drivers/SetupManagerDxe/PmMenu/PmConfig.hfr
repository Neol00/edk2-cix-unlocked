            prompt  = STRING_TOKEN(STR_PM_SOC_VOFFSET_PROMPT),
            help    = STRING_TOKEN(STR_PM_SOC_VOFFSET_HELP),
            flags   = NUMERIC_SIZE_2 | RESET_REQUIRED,
            minimum = 0,
            maximum = 500,
            step    = 10,
            default = 0,
        endnumeric;

    endform;
