// Power Management Configuration Form
    form formid = PM_CONFIG_FORM_ID,
        title  = STRING_TOKEN(STR_PM_FORM_TITLE);
        subtitle text = STRING_TOKEN(STR_EMPTY_STRING);
        //
        // ========== DVFS OPP Configuration ==========
