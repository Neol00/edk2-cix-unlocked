/** @file
 *
 *  Processor Properties Topology Table (PPTT) for CIX CD8180
 *
 *  CIX CD8180 (Sky1) SoC topology (ordered by MADT enumeration):
 *    Cluster B1: UID 0-1  (Cortex-A720 Big, boot cluster) - 64KB L1I, 64KB L1D, 512KB L2
 *    Cluster B0: UID 2-3  (Cortex-A720 Big)    - 64KB L1I, 64KB L1D, 512KB L2
 *    Cluster M0: UID 4-5  (Cortex-A720 Mid)    - 64KB L1I, 64KB L1D, 512KB L2
 *    Cluster M1: UID 6-7  (Cortex-A720 Mid)    - 64KB L1I, 64KB L1D, 512KB L2
 *    Cluster L0: UID 8-11 (Cortex-A520 Little) - 32KB L1I, 32KB L1D, no L2
 *    All 12 cores share a 12MB L3 cache (Haydn DSU)
 *
 *  Copyright 2024 Cix Technology Group Co., Ltd. All Rights Reserved.
 *
 *  SPDX-License-Identifier: BSD-2-Clause-Patent
 *
 **/

#include <Library/AcpiLib.h>
#include <IndustryStandard/Acpi.h>
#include <Include/AcpiPlatform.h>

#define FIELD_OFFSET(type, name) __builtin_offsetof(type, name)

//
// Cortex-A520 (Little) L1 cache parameters
//
#define A520_L1D_SIZE    SIZE_32KB
#define A520_L1D_SETS    128
#define A520_L1D_ASSC    4
#define A520_L1I_SIZE    SIZE_32KB
#define A520_L1I_SETS    128
#define A520_L1I_ASSC    4

//
// Cortex-A720 (Mid/Big) L1 cache parameters
//
#define A720_L1D_SIZE    SIZE_64KB
#define A720_L1D_SETS    256
#define A720_L1D_ASSC    4
#define A720_L1I_SIZE    SIZE_64KB
#define A720_L1I_SETS    256
#define A720_L1I_ASSC    4

//
// Cortex-A720 L2 cache parameters (per-cluster)
//
#define A720_L2_SIZE     SIZE_512KB
#define A720_L2_SETS     1024
#define A720_L2_ASSC     8

//
// Shared L3 cache parameters (Haydn DSU, 12MB)
//
#define L3_SIZE          (12 * SIZE_1MB)
#define L3_SETS          12288
#define L3_ASSC          16

//
// Cache line size for all caches
//
#define CACHE_LINE_SIZE  64

//
// Structures for each core type
//

// A520 core: L1D + L1I only (no L2)
#pragma pack(1)
typedef struct {
  EFI_ACPI_6_3_PPTT_STRUCTURE_PROCESSOR  Core;
  UINT32                                 Offset[2];   // L1D, L1I
  EFI_ACPI_6_3_PPTT_STRUCTURE_CACHE      DCache;
  EFI_ACPI_6_3_PPTT_STRUCTURE_CACHE      ICache;
} PPTT_A520_CORE;

// A720 core: L1D + L1I (L2 is at cluster level)
typedef struct {
  EFI_ACPI_6_3_PPTT_STRUCTURE_PROCESSOR  Core;
  UINT32                                 Offset[2];   // L1D, L1I
  EFI_ACPI_6_3_PPTT_STRUCTURE_CACHE      DCache;
  EFI_ACPI_6_3_PPTT_STRUCTURE_CACHE      ICache;
} PPTT_A720_CORE;

// Cluster L0: 4x A520, no L2
typedef struct {
  EFI_ACPI_6_3_PPTT_STRUCTURE_PROCESSOR  Cluster;
  PPTT_A520_CORE                         Cores[4];
} PPTT_CLUSTER_L0;

// Cluster with L2: 2x A720
typedef struct {
  EFI_ACPI_6_3_PPTT_STRUCTURE_PROCESSOR  Cluster;
  UINT32                                 Offset[1];   // L2
  EFI_ACPI_6_3_PPTT_STRUCTURE_CACHE      L2Cache;
  PPTT_A720_CORE                         Cores[2];
} PPTT_CLUSTER_A720;

// Package (SoC) with L3
// Cluster order matches MADT enumeration: Big1 (boot), Big0, Mid0, Mid1, Little
typedef struct {
  EFI_ACPI_6_3_PPTT_STRUCTURE_PROCESSOR  Package;
  UINT32                                 Offset[1];   // L3
  EFI_ACPI_6_3_PPTT_STRUCTURE_CACHE      L3Cache;
  PPTT_CLUSTER_A720                      ClusterB1;   // UID 0-1 (boot cluster)
  PPTT_CLUSTER_A720                      ClusterB0;   // UID 2-3
  PPTT_CLUSTER_A720                      ClusterM0;   // UID 4-5
  PPTT_CLUSTER_A720                      ClusterM1;   // UID 6-7
  PPTT_CLUSTER_L0                        ClusterL0;   // UID 8-11
} PPTT_PACKAGE;

// Full PPTT table
typedef struct {
  EFI_ACPI_6_3_PROCESSOR_PROPERTIES_TOPOLOGY_TABLE_HEADER  Pptt;
  PPTT_PACKAGE                                             Package;
} PPTT_TABLE;
#pragma pack()

//
// Helper macros for A520 core (L1 next-level points to L3 via package)
//
#define PPTT_A520_CORE_INIT(cluster_field, core_idx, acpi_uid)                  \
  {                                                                             \
    {                                                                           \
      EFI_ACPI_6_3_PPTT_TYPE_PROCESSOR,                                         \
      FIELD_OFFSET (PPTT_A520_CORE, DCache),                                    \
      {},                                                                       \
      {                                                                         \
        EFI_ACPI_6_3_PPTT_PACKAGE_NOT_PHYSICAL,                                 \
        EFI_ACPI_6_3_PPTT_PROCESSOR_ID_VALID,                                   \
        EFI_ACPI_6_3_PPTT_PROCESSOR_IS_NOT_THREAD,                              \
        EFI_ACPI_6_3_PPTT_NODE_IS_LEAF,                                         \
        EFI_ACPI_6_3_PPTT_IMPLEMENTATION_IDENTICAL,                             \
      },                                                                        \
      FIELD_OFFSET (PPTT_TABLE, Package.cluster_field),                         \
      acpi_uid,                                                                 \
      2,                                                                        \
    },                                                                          \
    {                                                                           \
      FIELD_OFFSET (PPTT_TABLE,                                                 \
        Package.cluster_field.Cores[core_idx].DCache),                          \
      FIELD_OFFSET (PPTT_TABLE,                                                 \
        Package.cluster_field.Cores[core_idx].ICache),                          \
    },                                                                          \
    {                                                                           \
      EFI_ACPI_6_3_PPTT_TYPE_CACHE,                                             \
      sizeof (EFI_ACPI_6_3_PPTT_STRUCTURE_CACHE), {},                           \
      { 1, 1, 1, 1, 1, 1, 1 },                                                 \
      FIELD_OFFSET (PPTT_TABLE, Package.L3Cache),                               \
      A520_L1D_SIZE, A520_L1D_SETS, A520_L1D_ASSC,                             \
      {                                                                         \
        EFI_ACPI_6_3_CACHE_ATTRIBUTES_ALLOCATION_READ_WRITE,                    \
        EFI_ACPI_6_3_CACHE_ATTRIBUTES_CACHE_TYPE_DATA,                          \
        EFI_ACPI_6_3_CACHE_ATTRIBUTES_WRITE_POLICY_WRITE_BACK,                  \
      },                                                                        \
      CACHE_LINE_SIZE,                                                          \
    },                                                                          \
    {                                                                           \
      EFI_ACPI_6_3_PPTT_TYPE_CACHE,                                             \
      sizeof (EFI_ACPI_6_3_PPTT_STRUCTURE_CACHE), {},                           \
      { 1, 1, 1, 1, 1, 0, 1 },                                                 \
      FIELD_OFFSET (PPTT_TABLE, Package.L3Cache),                               \
      A520_L1I_SIZE, A520_L1I_SETS, A520_L1I_ASSC,                             \
      {                                                                         \
        EFI_ACPI_6_3_CACHE_ATTRIBUTES_ALLOCATION_READ,                          \
        EFI_ACPI_6_3_CACHE_ATTRIBUTES_CACHE_TYPE_INSTRUCTION,                   \
        0,                                                                      \
      },                                                                        \
      CACHE_LINE_SIZE,                                                          \
    }                                                                           \
  }

//
// Helper macros for A720 core (L1 next-level points to cluster L2)
//
#define PPTT_A720_CORE_INIT(cluster_field, core_idx, acpi_uid)                  \
  {                                                                             \
    {                                                                           \
      EFI_ACPI_6_3_PPTT_TYPE_PROCESSOR,                                         \
      FIELD_OFFSET (PPTT_A720_CORE, DCache),                                    \
      {},                                                                       \
      {                                                                         \
        EFI_ACPI_6_3_PPTT_PACKAGE_NOT_PHYSICAL,                                 \
        EFI_ACPI_6_3_PPTT_PROCESSOR_ID_VALID,                                   \
        EFI_ACPI_6_3_PPTT_PROCESSOR_IS_NOT_THREAD,                              \
        EFI_ACPI_6_3_PPTT_NODE_IS_LEAF,                                         \
        EFI_ACPI_6_3_PPTT_IMPLEMENTATION_IDENTICAL,                             \
      },                                                                        \
      FIELD_OFFSET (PPTT_TABLE, Package.cluster_field),                         \
      acpi_uid,                                                                 \
      2,                                                                        \
    },                                                                          \
    {                                                                           \
      FIELD_OFFSET (PPTT_TABLE,                                                 \
        Package.cluster_field.Cores[core_idx].DCache),                          \
      FIELD_OFFSET (PPTT_TABLE,                                                 \
        Package.cluster_field.Cores[core_idx].ICache),                          \
    },                                                                          \
    {                                                                           \
      EFI_ACPI_6_3_PPTT_TYPE_CACHE,                                             \
      sizeof (EFI_ACPI_6_3_PPTT_STRUCTURE_CACHE), {},                           \
      { 1, 1, 1, 1, 1, 1, 1 },                                                 \
      FIELD_OFFSET (PPTT_TABLE, Package.cluster_field.L2Cache),                 \
      A720_L1D_SIZE, A720_L1D_SETS, A720_L1D_ASSC,                             \
      {                                                                         \
        EFI_ACPI_6_3_CACHE_ATTRIBUTES_ALLOCATION_READ_WRITE,                    \
        EFI_ACPI_6_3_CACHE_ATTRIBUTES_CACHE_TYPE_DATA,                          \
        EFI_ACPI_6_3_CACHE_ATTRIBUTES_WRITE_POLICY_WRITE_BACK,                  \
      },                                                                        \
      CACHE_LINE_SIZE,                                                          \
    },                                                                          \
    {                                                                           \
      EFI_ACPI_6_3_PPTT_TYPE_CACHE,                                             \
      sizeof (EFI_ACPI_6_3_PPTT_STRUCTURE_CACHE), {},                           \
      { 1, 1, 1, 1, 1, 0, 1 },                                                 \
      FIELD_OFFSET (PPTT_TABLE, Package.cluster_field.L2Cache),                 \
      A720_L1I_SIZE, A720_L1I_SETS, A720_L1I_ASSC,                             \
      {                                                                         \
        EFI_ACPI_6_3_CACHE_ATTRIBUTES_ALLOCATION_READ,                          \
        EFI_ACPI_6_3_CACHE_ATTRIBUTES_CACHE_TYPE_INSTRUCTION,                   \
        0,                                                                      \
      },                                                                        \
      CACHE_LINE_SIZE,                                                          \
    }                                                                           \
  }

//
// The PPTT table
//
PPTT_TABLE Pptt = {
  //
  // PPTT Header
  //
  {
    ARM_ACPI_HEADER (
      EFI_ACPI_6_3_PROCESSOR_PROPERTIES_TOPOLOGY_TABLE_STRUCTURE_SIGNATURE,
      PPTT_TABLE,
      EFI_ACPI_6_3_PROCESSOR_PROPERTIES_TOPOLOGY_TABLE_REVISION
    ),
  },
  //
  // Package (SoC)
  //
  {
    // Package processor node
    {
      EFI_ACPI_6_3_PPTT_TYPE_PROCESSOR,
      FIELD_OFFSET (PPTT_PACKAGE, L3Cache) -
        FIELD_OFFSET (PPTT_PACKAGE, Package),
      {},
      {
        EFI_ACPI_6_3_PPTT_PACKAGE_PHYSICAL,
        EFI_ACPI_6_3_PPTT_PROCESSOR_ID_INVALID,
        EFI_ACPI_6_3_PPTT_PROCESSOR_IS_NOT_THREAD,
        EFI_ACPI_6_3_PPTT_NODE_IS_NOT_LEAF,
        EFI_ACPI_6_3_PPTT_IMPLEMENTATION_NOT_IDENTICAL,
      },
      0,    // Parent (root)
      0,    // AcpiProcessorId
      1,    // NumberOfPrivateResources (L3)
    },
    // L3 cache offset
    {
      FIELD_OFFSET (PPTT_TABLE, Package.L3Cache),
    },
    // L3 cache (12MB shared)
    {
      EFI_ACPI_6_3_PPTT_TYPE_CACHE,
      sizeof (EFI_ACPI_6_3_PPTT_STRUCTURE_CACHE), {},
      { 1, 1, 1, 1, 1, 1, 1 },
      0,          // NextLevelOfCache (none)
      L3_SIZE,
      L3_SETS,
      L3_ASSC,
      {
        EFI_ACPI_6_3_CACHE_ATTRIBUTES_ALLOCATION_READ_WRITE,
        EFI_ACPI_6_3_CACHE_ATTRIBUTES_CACHE_TYPE_UNIFIED,
        EFI_ACPI_6_3_CACHE_ATTRIBUTES_WRITE_POLICY_WRITE_BACK,
      },
      CACHE_LINE_SIZE,
    },

    //
    // Cluster B1: 2x Cortex-A720 (Big, boot cluster) - UID 0-1
    //
    {
      // Cluster processor node
      {
        EFI_ACPI_6_3_PPTT_TYPE_PROCESSOR,
        FIELD_OFFSET (PPTT_CLUSTER_A720, L2Cache) -
          FIELD_OFFSET (PPTT_CLUSTER_A720, Cluster),
        {},
        {
          EFI_ACPI_6_3_PPTT_PACKAGE_NOT_PHYSICAL,
          EFI_ACPI_6_3_PPTT_PROCESSOR_ID_INVALID,
          EFI_ACPI_6_3_PPTT_PROCESSOR_IS_NOT_THREAD,
          EFI_ACPI_6_3_PPTT_NODE_IS_NOT_LEAF,
          EFI_ACPI_6_3_PPTT_IMPLEMENTATION_IDENTICAL,
        },
        FIELD_OFFSET (PPTT_TABLE, Package),   // Parent = Package
        0,
        1,    // NumberOfPrivateResources (L2)
      },
      // L2 cache offset
      {
        FIELD_OFFSET (PPTT_TABLE, Package.ClusterB1.L2Cache),
      },
      // L2 cache (512KB)
      {
        EFI_ACPI_6_3_PPTT_TYPE_CACHE,
        sizeof (EFI_ACPI_6_3_PPTT_STRUCTURE_CACHE), {},
        { 1, 1, 1, 1, 1, 1, 1 },
        FIELD_OFFSET (PPTT_TABLE, Package.L3Cache),
        A720_L2_SIZE, A720_L2_SETS, A720_L2_ASSC,
        {
          EFI_ACPI_6_3_CACHE_ATTRIBUTES_ALLOCATION_READ_WRITE,
          EFI_ACPI_6_3_CACHE_ATTRIBUTES_CACHE_TYPE_UNIFIED,
          EFI_ACPI_6_3_CACHE_ATTRIBUTES_WRITE_POLICY_WRITE_BACK,
        },
        CACHE_LINE_SIZE,
      },
      {
        PPTT_A720_CORE_INIT (ClusterB1, 0, 0),
        PPTT_A720_CORE_INIT (ClusterB1, 1, 1),
      },
    },

    //
    // Cluster B0: 2x Cortex-A720 (Big) - UID 2-3
    //
    {
      {
        EFI_ACPI_6_3_PPTT_TYPE_PROCESSOR,
        FIELD_OFFSET (PPTT_CLUSTER_A720, L2Cache) -
          FIELD_OFFSET (PPTT_CLUSTER_A720, Cluster),
        {},
        {
          EFI_ACPI_6_3_PPTT_PACKAGE_NOT_PHYSICAL,
          EFI_ACPI_6_3_PPTT_PROCESSOR_ID_INVALID,
          EFI_ACPI_6_3_PPTT_PROCESSOR_IS_NOT_THREAD,
          EFI_ACPI_6_3_PPTT_NODE_IS_NOT_LEAF,
          EFI_ACPI_6_3_PPTT_IMPLEMENTATION_IDENTICAL,
        },
        FIELD_OFFSET (PPTT_TABLE, Package),
        0,
        1,
      },
      {
        FIELD_OFFSET (PPTT_TABLE, Package.ClusterB0.L2Cache),
      },
      {
        EFI_ACPI_6_3_PPTT_TYPE_CACHE,
        sizeof (EFI_ACPI_6_3_PPTT_STRUCTURE_CACHE), {},
        { 1, 1, 1, 1, 1, 1, 1 },
        FIELD_OFFSET (PPTT_TABLE, Package.L3Cache),
        A720_L2_SIZE, A720_L2_SETS, A720_L2_ASSC,
        {
          EFI_ACPI_6_3_CACHE_ATTRIBUTES_ALLOCATION_READ_WRITE,
          EFI_ACPI_6_3_CACHE_ATTRIBUTES_CACHE_TYPE_UNIFIED,
          EFI_ACPI_6_3_CACHE_ATTRIBUTES_WRITE_POLICY_WRITE_BACK,
        },
        CACHE_LINE_SIZE,
      },
      {
        PPTT_A720_CORE_INIT (ClusterB0, 0, 2),
        PPTT_A720_CORE_INIT (ClusterB0, 1, 3),
      },
    },

    //
    // Cluster M0: 2x Cortex-A720 (Mid) - UID 4-5
    //
    {
      {
        EFI_ACPI_6_3_PPTT_TYPE_PROCESSOR,
        FIELD_OFFSET (PPTT_CLUSTER_A720, L2Cache) -
          FIELD_OFFSET (PPTT_CLUSTER_A720, Cluster),
        {},
        {
          EFI_ACPI_6_3_PPTT_PACKAGE_NOT_PHYSICAL,
          EFI_ACPI_6_3_PPTT_PROCESSOR_ID_INVALID,
          EFI_ACPI_6_3_PPTT_PROCESSOR_IS_NOT_THREAD,
          EFI_ACPI_6_3_PPTT_NODE_IS_NOT_LEAF,
          EFI_ACPI_6_3_PPTT_IMPLEMENTATION_IDENTICAL,
        },
        FIELD_OFFSET (PPTT_TABLE, Package),
        0,
        1,
      },
      {
        FIELD_OFFSET (PPTT_TABLE, Package.ClusterM0.L2Cache),
      },
      {
        EFI_ACPI_6_3_PPTT_TYPE_CACHE,
        sizeof (EFI_ACPI_6_3_PPTT_STRUCTURE_CACHE), {},
        { 1, 1, 1, 1, 1, 1, 1 },
        FIELD_OFFSET (PPTT_TABLE, Package.L3Cache),
        A720_L2_SIZE, A720_L2_SETS, A720_L2_ASSC,
        {
          EFI_ACPI_6_3_CACHE_ATTRIBUTES_ALLOCATION_READ_WRITE,
          EFI_ACPI_6_3_CACHE_ATTRIBUTES_CACHE_TYPE_UNIFIED,
          EFI_ACPI_6_3_CACHE_ATTRIBUTES_WRITE_POLICY_WRITE_BACK,
        },
        CACHE_LINE_SIZE,
      },
      {
        PPTT_A720_CORE_INIT (ClusterM0, 0, 4),
        PPTT_A720_CORE_INIT (ClusterM0, 1, 5),
      },
    },

    //
    // Cluster M1: 2x Cortex-A720 (Mid) - UID 6-7
    //
    {
      {
        EFI_ACPI_6_3_PPTT_TYPE_PROCESSOR,
        FIELD_OFFSET (PPTT_CLUSTER_A720, L2Cache) -
          FIELD_OFFSET (PPTT_CLUSTER_A720, Cluster),
        {},
        {
          EFI_ACPI_6_3_PPTT_PACKAGE_NOT_PHYSICAL,
          EFI_ACPI_6_3_PPTT_PROCESSOR_ID_INVALID,
          EFI_ACPI_6_3_PPTT_PROCESSOR_IS_NOT_THREAD,
          EFI_ACPI_6_3_PPTT_NODE_IS_NOT_LEAF,
          EFI_ACPI_6_3_PPTT_IMPLEMENTATION_IDENTICAL,
        },
        FIELD_OFFSET (PPTT_TABLE, Package),
        0,
        1,
      },
      {
        FIELD_OFFSET (PPTT_TABLE, Package.ClusterM1.L2Cache),
      },
      {
        EFI_ACPI_6_3_PPTT_TYPE_CACHE,
        sizeof (EFI_ACPI_6_3_PPTT_STRUCTURE_CACHE), {},
        { 1, 1, 1, 1, 1, 1, 1 },
        FIELD_OFFSET (PPTT_TABLE, Package.L3Cache),
        A720_L2_SIZE, A720_L2_SETS, A720_L2_ASSC,
        {
          EFI_ACPI_6_3_CACHE_ATTRIBUTES_ALLOCATION_READ_WRITE,
          EFI_ACPI_6_3_CACHE_ATTRIBUTES_CACHE_TYPE_UNIFIED,
          EFI_ACPI_6_3_CACHE_ATTRIBUTES_WRITE_POLICY_WRITE_BACK,
        },
        CACHE_LINE_SIZE,
      },
      {
        PPTT_A720_CORE_INIT (ClusterM1, 0, 6),
        PPTT_A720_CORE_INIT (ClusterM1, 1, 7),
      },
    },

    //
    // Cluster L0: 4x Cortex-A520 (Little) - UID 8-11, no L2
    //
    {
      // Cluster processor node
      {
        EFI_ACPI_6_3_PPTT_TYPE_PROCESSOR,
        sizeof (EFI_ACPI_6_3_PPTT_STRUCTURE_PROCESSOR),
        {},
        {
          EFI_ACPI_6_3_PPTT_PACKAGE_NOT_PHYSICAL,
          EFI_ACPI_6_3_PPTT_PROCESSOR_ID_INVALID,
          EFI_ACPI_6_3_PPTT_PROCESSOR_IS_NOT_THREAD,
          EFI_ACPI_6_3_PPTT_NODE_IS_NOT_LEAF,
          EFI_ACPI_6_3_PPTT_IMPLEMENTATION_IDENTICAL,
        },
        FIELD_OFFSET (PPTT_TABLE, Package),   // Parent = Package
        0,
        0,    // No private resources (no L2 for A520)
      },
      {
        PPTT_A520_CORE_INIT (ClusterL0, 0, 8),
        PPTT_A520_CORE_INIT (ClusterL0, 1, 9),
        PPTT_A520_CORE_INIT (ClusterL0, 2, 10),
        PPTT_A520_CORE_INIT (ClusterL0, 3, 11),
      },
    },
  },
};

VOID * CONST ReferenceAcpiTable = &Pptt;
