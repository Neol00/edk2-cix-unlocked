/** @file
 *
 *  Processor Properties Topology Table (PPTT) for CIX CD8180
 *
 *  CIX CD8180 (Sky1) SoC topology — 3 performance clusters:
 *    Cluster 0 (Little):  4x Cortex-A520  UIDs  8-11  (L_CLUSTER_ID  = 0)
 *    Cluster 1 (Mid):     4x Cortex-A720  UIDs  4-7   (BL_CLUSTER_ID = 1)
 *    Cluster 2 (Big):     4x Cortex-A720  UIDs  0-3   (AB_CLUSTER_ID = 2)
 *    All 12 cores share a 12MB L3 cache (Haydn DSU)
 *
 *  3 clusters × 4 cores aligns with MAX_CLUSTER_NR=3 / MAX_CPUS_PER_CLUSTER=4
 *  in the CIX core_ctl driver (drivers/soc/cix/sched/common.h).
 *
 *  Although PPTT groups cores into 3 clusters, each physical sub-cluster
 *  (B1/B0/M0/M1) has its own SCMI performance domain and CPPC DesiredPerf
 *  register, so the OS can set independent frequencies per core pair via
 *  the 5-domain PSD/CPC tables in AcpiPlatform.h.
 *
 *  Each A720 core has a private 512KB L2; A520 cores have no physical L2
 *  (placeholder chain node, size=0, maintains consistent hierarchy depth).
 *  Cache hierarchy is established via NextLevelOfCache chains only.
 *  Cluster and package processor nodes carry 0 private resources to avoid
 *  kernel double-counting caches.
 *
 *  Copyright 2024 Cix Technology Group Co., Ltd. All Rights Reserved.
 *
 *  SPDX-License-Identifier: BSD-2-Clause-Patent
 *
 **/

#include <Library/AcpiLib.h>
#include <IndustryStandard/Acpi.h>
#include <Include/AcpiPlatform.h>

#define FIELD_OFFSET(type, name) __builtin_offsetof(type, name)

//
// Cortex-A520 (Little) L1 cache parameters
//
#define A520_L1D_SIZE    SIZE_32KB
#define A520_L1D_SETS    128
#define A520_L1D_ASSC    4
#define A520_L1I_SIZE    SIZE_32KB
#define A520_L1I_SETS    128
#define A520_L1I_ASSC    4

//
// Cortex-A720 (Mid/Big) L1 cache parameters
//
#define A720_L1D_SIZE    SIZE_64KB
#define A720_L1D_SETS    256
#define A720_L1D_ASSC    4
#define A720_L1I_SIZE    SIZE_64KB
#define A720_L1I_SETS    256
#define A720_L1I_ASSC    4

//
// Cortex-A720 L2 cache parameters (per-core, 512KB)
//
#define A720_L2_SIZE     SIZE_512KB
#define A720_L2_SETS     1024
#define A720_L2_ASSC     8

//
// Shared L3 cache parameters (Haydn DSU, 12MB)
//
#define L3_SIZE          SIZE_1MB
#define L3_SETS          1024
#define L3_ASSC          16

//
// Cache line size for all caches
//
#define CACHE_LINE_SIZE  64

//
// Structure definitions — caches are found via NextLevelOfCache only.
// Cluster/package nodes have 0 private resources.
//

#pragma pack(1)

// A520 core: L1D + L1I + L2 placeholder (size 0, maintains 3-level chain)
typedef struct {
  EFI_ACPI_6_3_PPTT_STRUCTURE_PROCESSOR  Core;
  UINT32                                 Offset[2];   // L1D, L1I
  EFI_ACPI_6_3_PPTT_STRUCTURE_CACHE      DCache;
  EFI_ACPI_6_3_PPTT_STRUCTURE_CACHE      ICache;
  EFI_ACPI_6_3_PPTT_STRUCTURE_CACHE      L2Cache;     // Placeholder (size 0)
} PPTT_A520_CORE;

// A720 core: L1D + L1I + per-core L2 (512KB)
typedef struct {
  EFI_ACPI_6_3_PPTT_STRUCTURE_PROCESSOR  Core;
  UINT32                                 Offset[2];   // L1D, L1I
  EFI_ACPI_6_3_PPTT_STRUCTURE_CACHE      DCache;
  EFI_ACPI_6_3_PPTT_STRUCTURE_CACHE      ICache;
  EFI_ACPI_6_3_PPTT_STRUCTURE_CACHE      L2Cache;     // Per-core 512KB
} PPTT_A720_CORE;

// 4-core A520 cluster — cluster_id=0 (Little)
typedef struct {
  EFI_ACPI_6_3_PPTT_STRUCTURE_PROCESSOR  Cluster;
  PPTT_A520_CORE                         Cores[4];
} PPTT_CLUSTER_A520_4;

// 4-core A720 cluster — cluster_id=1 (Mid) or cluster_id=2 (Big)
typedef struct {
  EFI_ACPI_6_3_PPTT_STRUCTURE_PROCESSOR  Cluster;
  PPTT_A720_CORE                         Cores[4];
} PPTT_CLUSTER_A720_4;

// Package: L3 cache, then clusters in cluster_id order (L=0, M=1, B=2)
typedef struct {
  EFI_ACPI_6_3_PPTT_STRUCTURE_PROCESSOR  Package;
  EFI_ACPI_6_3_PPTT_STRUCTURE_CACHE      L3Cache;
  PPTT_CLUSTER_A520_4                    ClusterL;    // cluster_id=0, UIDs 8-11
  PPTT_CLUSTER_A720_4                    ClusterM;    // cluster_id=1, UIDs 4-7
  PPTT_CLUSTER_A720_4                    ClusterB;    // cluster_id=2, UIDs 0-3
} PPTT_PACKAGE;

// Full PPTT table
typedef struct {
  EFI_ACPI_6_3_PROCESSOR_PROPERTIES_TOPOLOGY_TABLE_HEADER  Pptt;
  PPTT_PACKAGE                                             Package;
} PPTT_TABLE;
#pragma pack()

//
// Helper macro for A520 core (L1 → L2 placeholder → L3)
//
#define PPTT_A520_CORE_INIT(cluster_field, core_idx, acpi_uid)                  \
  {                                                                             \
    {                                                                           \
      EFI_ACPI_6_3_PPTT_TYPE_PROCESSOR,                                         \
      FIELD_OFFSET (PPTT_A520_CORE, DCache),                                    \
      {},                                                                       \
      {                                                                         \
        EFI_ACPI_6_3_PPTT_PACKAGE_NOT_PHYSICAL,                                 \
        EFI_ACPI_6_3_PPTT_PROCESSOR_ID_VALID,                                   \
        EFI_ACPI_6_3_PPTT_PROCESSOR_IS_NOT_THREAD,                              \
        EFI_ACPI_6_3_PPTT_NODE_IS_LEAF,                                         \
        EFI_ACPI_6_3_PPTT_IMPLEMENTATION_IDENTICAL,                             \
      },                                                                        \
      FIELD_OFFSET (PPTT_TABLE, Package.cluster_field),                         \
      acpi_uid,                                                                 \
      2,                                                                        \
    },                                                                          \
    {                                                                           \
      FIELD_OFFSET (PPTT_TABLE,                                                 \
        Package.cluster_field.Cores[core_idx].DCache),                          \
      FIELD_OFFSET (PPTT_TABLE,                                                 \
        Package.cluster_field.Cores[core_idx].ICache),                          \
    },                                                                          \
    /* L1D → per-core L2 placeholder */                                         \
    {                                                                           \
      EFI_ACPI_6_3_PPTT_TYPE_CACHE,                                             \
      sizeof (EFI_ACPI_6_3_PPTT_STRUCTURE_CACHE), {},                           \
      { 1, 1, 1, 1, 1, 1, 1 },                                                 \
      FIELD_OFFSET (PPTT_TABLE,                                                 \
        Package.cluster_field.Cores[core_idx].L2Cache),                         \
      A520_L1D_SIZE, A520_L1D_SETS, A520_L1D_ASSC,                             \
      {                                                                         \
        EFI_ACPI_6_3_CACHE_ATTRIBUTES_ALLOCATION_READ_WRITE,                    \
        EFI_ACPI_6_3_CACHE_ATTRIBUTES_CACHE_TYPE_DATA,                          \
        EFI_ACPI_6_3_CACHE_ATTRIBUTES_WRITE_POLICY_WRITE_BACK,                  \
      },                                                                        \
      CACHE_LINE_SIZE,                                                          \
    },                                                                          \
    /* L1I → per-core L2 placeholder */                                         \
    {                                                                           \
      EFI_ACPI_6_3_PPTT_TYPE_CACHE,                                             \
      sizeof (EFI_ACPI_6_3_PPTT_STRUCTURE_CACHE), {},                           \
      { 1, 1, 1, 1, 1, 0, 1 },                                                 \
      FIELD_OFFSET (PPTT_TABLE,                                                 \
        Package.cluster_field.Cores[core_idx].L2Cache),                         \
      A520_L1I_SIZE, A520_L1I_SETS, A520_L1I_ASSC,                             \
      {                                                                         \
        EFI_ACPI_6_3_CACHE_ATTRIBUTES_ALLOCATION_READ,                          \
        EFI_ACPI_6_3_CACHE_ATTRIBUTES_CACHE_TYPE_INSTRUCTION,                   \
        0,                                                                      \
      },                                                                        \
      CACHE_LINE_SIZE,                                                          \
    },                                                                          \
    /* L2 placeholder (size 0) → L3 */                                          \
    {                                                                           \
      EFI_ACPI_6_3_PPTT_TYPE_CACHE,                                             \
      sizeof (EFI_ACPI_6_3_PPTT_STRUCTURE_CACHE), {},                           \
      { 0, 0, 0, 0, 1, 0, 0 },                                                 \
      FIELD_OFFSET (PPTT_TABLE, Package.L3Cache),                               \
      0, 0, 0,                                                                  \
      {                                                                         \
        0,                                                                      \
        EFI_ACPI_6_3_CACHE_ATTRIBUTES_CACHE_TYPE_UNIFIED,                       \
        0,                                                                      \
      },                                                                        \
      0,                                                                        \
    }                                                                           \
  }

//
// Helper macro for A720 core (L1 → per-core L2 512KB → L3)
//
#define PPTT_A720_CORE_INIT(cluster_field, core_idx, acpi_uid)                  \
  {                                                                             \
    {                                                                           \
      EFI_ACPI_6_3_PPTT_TYPE_PROCESSOR,                                         \
      FIELD_OFFSET (PPTT_A720_CORE, DCache),                                    \
      {},                                                                       \
      {                                                                         \
        EFI_ACPI_6_3_PPTT_PACKAGE_NOT_PHYSICAL,                                 \
        EFI_ACPI_6_3_PPTT_PROCESSOR_ID_VALID,                                   \
        EFI_ACPI_6_3_PPTT_PROCESSOR_IS_NOT_THREAD,                              \
        EFI_ACPI_6_3_PPTT_NODE_IS_LEAF,                                         \
        EFI_ACPI_6_3_PPTT_IMPLEMENTATION_IDENTICAL,                             \
      },                                                                        \
      FIELD_OFFSET (PPTT_TABLE, Package.cluster_field),                         \
      acpi_uid,                                                                 \
      2,                                                                        \
    },                                                                          \
    {                                                                           \
      FIELD_OFFSET (PPTT_TABLE,                                                 \
        Package.cluster_field.Cores[core_idx].DCache),                          \
      FIELD_OFFSET (PPTT_TABLE,                                                 \
        Package.cluster_field.Cores[core_idx].ICache),                          \
    },                                                                          \
    /* L1D → per-core L2 */                                                     \
    {                                                                           \
      EFI_ACPI_6_3_PPTT_TYPE_CACHE,                                             \
      sizeof (EFI_ACPI_6_3_PPTT_STRUCTURE_CACHE), {},                           \
      { 1, 1, 1, 1, 1, 1, 1 },                                                 \
      FIELD_OFFSET (PPTT_TABLE,                                                 \
        Package.cluster_field.Cores[core_idx].L2Cache),                         \
      A720_L1D_SIZE, A720_L1D_SETS, A720_L1D_ASSC,                             \
      {                                                                         \
        EFI_ACPI_6_3_CACHE_ATTRIBUTES_ALLOCATION_READ_WRITE,                    \
        EFI_ACPI_6_3_CACHE_ATTRIBUTES_CACHE_TYPE_DATA,                          \
        EFI_ACPI_6_3_CACHE_ATTRIBUTES_WRITE_POLICY_WRITE_BACK,                  \
      },                                                                        \
      CACHE_LINE_SIZE,                                                          \
    },                                                                          \
    /* L1I → per-core L2 */                                                     \
    {                                                                           \
      EFI_ACPI_6_3_PPTT_TYPE_CACHE,                                             \
      sizeof (EFI_ACPI_6_3_PPTT_STRUCTURE_CACHE), {},                           \
      { 1, 1, 1, 1, 1, 0, 1 },                                                 \
      FIELD_OFFSET (PPTT_TABLE,                                                 \
        Package.cluster_field.Cores[core_idx].L2Cache),                         \
      A720_L1I_SIZE, A720_L1I_SETS, A720_L1I_ASSC,                             \
      {                                                                         \
        EFI_ACPI_6_3_CACHE_ATTRIBUTES_ALLOCATION_READ,                          \
        EFI_ACPI_6_3_CACHE_ATTRIBUTES_CACHE_TYPE_INSTRUCTION,                   \
        0,                                                                      \
      },                                                                        \
      CACHE_LINE_SIZE,                                                          \
    },                                                                          \
    /* Per-core L2 (512KB) → L3 */                                              \
    {                                                                           \
      EFI_ACPI_6_3_PPTT_TYPE_CACHE,                                             \
      sizeof (EFI_ACPI_6_3_PPTT_STRUCTURE_CACHE), {},                           \
      { 1, 1, 1, 1, 1, 1, 1 },                                                 \
      FIELD_OFFSET (PPTT_TABLE, Package.L3Cache),                               \
      A720_L2_SIZE, A720_L2_SETS, A720_L2_ASSC,                                \
      {                                                                         \
        EFI_ACPI_6_3_CACHE_ATTRIBUTES_ALLOCATION_READ_WRITE,                    \
        EFI_ACPI_6_3_CACHE_ATTRIBUTES_CACHE_TYPE_UNIFIED,                       \
        EFI_ACPI_6_3_CACHE_ATTRIBUTES_WRITE_POLICY_WRITE_BACK,                  \
      },                                                                        \
      CACHE_LINE_SIZE,                                                          \
    }                                                                           \
  }

//
// The PPTT table
//
PPTT_TABLE Pptt = {
  //
  // PPTT Header
  //
  {
    ARM_ACPI_HEADER (
      EFI_ACPI_6_3_PROCESSOR_PROPERTIES_TOPOLOGY_TABLE_STRUCTURE_SIGNATURE,
      PPTT_TABLE,
      EFI_ACPI_6_3_PROCESSOR_PROPERTIES_TOPOLOGY_TABLE_REVISION
    ),
  },
  //
  // Package (SoC) — 0 private resources; L3 found via NextLevel chains
  //
  {
    {
      EFI_ACPI_6_3_PPTT_TYPE_PROCESSOR,
      sizeof (EFI_ACPI_6_3_PPTT_STRUCTURE_PROCESSOR),
      {},
      {
        EFI_ACPI_6_3_PPTT_PACKAGE_PHYSICAL,
        EFI_ACPI_6_3_PPTT_PROCESSOR_ID_INVALID,
        EFI_ACPI_6_3_PPTT_PROCESSOR_IS_NOT_THREAD,
        EFI_ACPI_6_3_PPTT_NODE_IS_NOT_LEAF,
        EFI_ACPI_6_3_PPTT_IMPLEMENTATION_NOT_IDENTICAL,
      },
      0,    // Parent (root)
      0,    // AcpiProcessorId
      0,    // NumberOfPrivateResources
    },
    // L3 cache (12MB shared) — standalone structure, referenced via L2 NextLevel
    {
      EFI_ACPI_6_3_PPTT_TYPE_CACHE,
      sizeof (EFI_ACPI_6_3_PPTT_STRUCTURE_CACHE), {},
      { 1, 1, 1, 1, 1, 1, 1 },
      0,          // NextLevelOfCache (none — L3 is the last level)
      L3_SIZE,
      L3_SETS,
      L3_ASSC,
      {
        EFI_ACPI_6_3_CACHE_ATTRIBUTES_ALLOCATION_READ_WRITE,
        EFI_ACPI_6_3_CACHE_ATTRIBUTES_CACHE_TYPE_UNIFIED,
        EFI_ACPI_6_3_CACHE_ATTRIBUTES_WRITE_POLICY_WRITE_BACK,
      },
      CACHE_LINE_SIZE,
    },

    //
    // Cluster L (cluster_id=0): 4x Cortex-A520 Little — UIDs 8-11
    // Must be first cluster node so kernel assigns cluster_id=0 = L_CLUSTER_ID
    //
    {
      {
        EFI_ACPI_6_3_PPTT_TYPE_PROCESSOR,
        sizeof (EFI_ACPI_6_3_PPTT_STRUCTURE_PROCESSOR),
        {},
        {
          EFI_ACPI_6_3_PPTT_PACKAGE_NOT_PHYSICAL,
          EFI_ACPI_6_3_PPTT_PROCESSOR_ID_INVALID,
          EFI_ACPI_6_3_PPTT_PROCESSOR_IS_NOT_THREAD,
          EFI_ACPI_6_3_PPTT_NODE_IS_NOT_LEAF,
          EFI_ACPI_6_3_PPTT_IMPLEMENTATION_IDENTICAL,
        },
        FIELD_OFFSET (PPTT_TABLE, Package),
        0,
        0,
      },
      {
        PPTT_A520_CORE_INIT (ClusterL, 0,  8),
        PPTT_A520_CORE_INIT (ClusterL, 1,  9),
        PPTT_A520_CORE_INIT (ClusterL, 2, 10),
        PPTT_A520_CORE_INIT (ClusterL, 3, 11),
      },
    },

    //
    // Cluster M (cluster_id=1): 4x Cortex-A720 Mid — UIDs 4-7
    // Second cluster node → cluster_id=1 = BL_CLUSTER_ID
    // Sub-clusters M0 (UIDs 4-5) and M1 (UIDs 6-7) have independent
    // DVFS via separate PSD domains and CPPC DesiredPerf registers.
    //
    {
      {
        EFI_ACPI_6_3_PPTT_TYPE_PROCESSOR,
        sizeof (EFI_ACPI_6_3_PPTT_STRUCTURE_PROCESSOR),
        {},
        {
          EFI_ACPI_6_3_PPTT_PACKAGE_NOT_PHYSICAL,
          EFI_ACPI_6_3_PPTT_PROCESSOR_ID_INVALID,
          EFI_ACPI_6_3_PPTT_PROCESSOR_IS_NOT_THREAD,
          EFI_ACPI_6_3_PPTT_NODE_IS_NOT_LEAF,
          EFI_ACPI_6_3_PPTT_IMPLEMENTATION_IDENTICAL,
        },
        FIELD_OFFSET (PPTT_TABLE, Package),
        0,
        0,
      },
      {
        PPTT_A720_CORE_INIT (ClusterM, 0, 4),
        PPTT_A720_CORE_INIT (ClusterM, 1, 5),
        PPTT_A720_CORE_INIT (ClusterM, 2, 6),
        PPTT_A720_CORE_INIT (ClusterM, 3, 7),
      },
    },

    //
    // Cluster B (cluster_id=2): 4x Cortex-A720 Big — UIDs 0-3
    // Third cluster node → cluster_id=2 = AB_CLUSTER_ID
    // Sub-clusters B1 (UIDs 0-1, boot core) and B0 (UIDs 2-3) have
    // independent DVFS via separate PSD domains and CPPC DesiredPerf registers.
    //
    {
      {
        EFI_ACPI_6_3_PPTT_TYPE_PROCESSOR,
        sizeof (EFI_ACPI_6_3_PPTT_STRUCTURE_PROCESSOR),
        {},
        {
          EFI_ACPI_6_3_PPTT_PACKAGE_NOT_PHYSICAL,
          EFI_ACPI_6_3_PPTT_PROCESSOR_ID_INVALID,
          EFI_ACPI_6_3_PPTT_PROCESSOR_IS_NOT_THREAD,
          EFI_ACPI_6_3_PPTT_NODE_IS_NOT_LEAF,
          EFI_ACPI_6_3_PPTT_IMPLEMENTATION_IDENTICAL,
        },
        FIELD_OFFSET (PPTT_TABLE, Package),
        0,
        0,
      },
      {
        PPTT_A720_CORE_INIT (ClusterB, 0, 0),
        PPTT_A720_CORE_INIT (ClusterB, 1, 1),
        PPTT_A720_CORE_INIT (ClusterB, 2, 2),
        PPTT_A720_CORE_INIT (ClusterB, 3, 3),
      },
    },
  },
};

VOID * CONST ReferenceAcpiTable = &Pptt;
